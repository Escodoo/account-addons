<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form_purchase">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <block name="invoicing_settings_container" position="inside">
                <setting
                    id="enable_purchase_mis_cash_flow_forecast"
                    company_dependent="1"
                    help="Enable MIS Builder Cash Flow Generate Purchase Forecast"
                >
                    <field name="enable_purchase_mis_cash_flow_forecast" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
