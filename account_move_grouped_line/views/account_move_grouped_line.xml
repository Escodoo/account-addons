<odoo>


    <record id="account_move_grouped_line_tree_view" model="ir.ui.view">
        <field name="name">account.move.grouped.line.tree</field>
        <field name="model">account.move.grouped.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="account_id" />
                <field name="name" />
                <field name="analytic_account_id" />
                <field name="analytic_tag_ids" />
                <field name="tax_ids" />
                <field name="debit" sum="total debit" />
                <field name="credit" sum="total credit" />

                <field name="account_move_id" invisible="1" />
            </tree>
        </field>
    </record>


</odoo>
