#. module: account_account_deactivation_date
#: model:ir.model,name:account_account_deactivation_date.model_account_account
msgid "Account"
msgstr "Conta"

#. module: account_account_deactivation_date
#: model:ir.actions.server,name:account_account_deactivation_date.ir_cron_deprecate_due_accounts_ir_actions_server
msgid "Account: Deprecate accounts on their deactivation date"
msgstr "Conta: Inativar contas na data de inativação"

#. module: account_account_deactivation_date
#: model:ir.model.fields,field_description:account_account_deactivation_date.field_account_account__deactivation_date
msgid "Deactivation Date"
msgstr "Data de Inativação"

#. module: account_account_deactivation_date
#: model:ir.model.fields,help:account_account_deactivation_date.field_account_account__deactivation_date
msgid ""
"From this date on, journal entries can no longer use the account and, once "
"the date is reached, the account is deprecated. Entries dated before it "
"remain valid."
msgstr ""
"A partir desta data, os lançamentos não podem mais usar a conta e, quando a "
"data é atingida, a conta é inativada. Lançamentos com data anterior "
"continuam válidos."

#. module: account_account_deactivation_date
#: model_terms:ir.ui.view,arch_db:account_account_deactivation_date.view_account_search
msgid "Inactive Account"
msgstr "Conta inativa"

#. module: account_account_deactivation_date
#: model:ir.model,name:account_account_deactivation_date.model_account_move
msgid "Journal Entry"
msgstr "Lançamento de diário"

#. module: account_account_deactivation_date
#: model:ir.model,name:account_account_deactivation_date.model_account_move_line
msgid "Journal Item"
msgstr "Item de diário"

#. module: account_account_deactivation_date
#: model_terms:ir.ui.view,arch_db:account_account_deactivation_date.view_account_search
msgid "Scheduled Deactivation"
msgstr "Inativação agendada"

#. module: account_account_deactivation_date
#. odoo-python
#: code:addons/account_account_deactivation_date/models/account_move_line.py:0
msgid ""
"The account %(account)s is inactive since %(date)s and cannot be used in "
"entries dated %(line_date)s."
msgstr ""
"A conta %(account)s está inativa desde %(date)s e não pode ser usada em "
"lançamentos com data %(line_date)s."

#. module: account_account_deactivation_date
#. odoo-python
#: code:addons/account_account_deactivation_date/models/account_account.py:0
msgid ""
"The account could not be deprecated on its deactivation date: %(error)s"
msgstr "Não foi possível inativar a conta na data de inativação: %(error)s"

#. module: account_account_deactivation_date
#. odoo-python
#: code:addons/account_account_deactivation_date/models/account_account.py:0
msgid ""
"The deactivation date of account %(account)s must be later than %(date)s, "
"the date of its last posted journal item."
msgstr ""
"A data de inativação da conta %(account)s deve ser posterior a %(date)s, "
"data do seu último item de diário lançado."

#. module: account_account_deactivation_date
#. odoo-python
#: code:addons/account_account_deactivation_date/models/account_account.py:0
msgid ""
"You cannot set a deactivation date on accounts used in a tax distribution: "
"%(accounts)s"
msgstr ""
"Não é possível definir data de inativação em contas usadas em uma "
"distribuição de impostos: %(accounts)s"
