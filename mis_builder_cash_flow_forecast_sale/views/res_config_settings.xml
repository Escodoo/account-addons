<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field
            name="name"
        >res.config.settings in (mis_builder_cash_flow_forecast_sale)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="invoicing_setting_container" position="inside">
                <setting
                    id="enable_sale_mis_cash_flow_forecast"
                    company_dependent="1"
                    help="Enable MIS Builder Cash Flow Generate Sale Forecast"
                >
                    <field name="enable_sale_mis_cash_flow_forecast" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
