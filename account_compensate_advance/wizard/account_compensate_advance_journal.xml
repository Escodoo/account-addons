<odoo>

    <record model="ir.ui.view" id="account_compensate_advance_form_view">
        <field name="name">account.compensate.advance.journal.form</field>
        <field name="model">account.compensate.advance.journal</field>
        <field name="arch" type="xml">
            <form string="Compensate Advance Account">
                <sheet>
                    <field name="currency_id" invisible="1" />
                    <group>
                        <group string="Advance">
                            <field
                                name="advance_id"
                                options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                            <field name="advance_balance" readonly="1" />
                        </group>
                        <group string="To Compensate">
                            <field name="date" />
                            <field
                                name="journal_id"
                                options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                            <field
                                name="line_id"
                                options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Compensate"
                        name="action_compensate_advance_account"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
