<odoo>
    <record model="ir.ui.view" id="document_form_inherit">
        <field
            name="name"
        >l10n_br_fiscal.document.form (in l10n_br_fiscal_document_cancel_group)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <button name="action_document_cancel" position="attributes">
                <attribute
                    name="groups"
                >l10n_br_fiscal_document_cancel_group.group_cancel_fiscal_documents</attribute>
            </button>
        </field>
    </record>
</odoo>
