<odoo>
    <template
        id="assets_backend"
        name="mis_builder_custom_reports"
        inherit_id="web.assets_backend"
    >
        <xpath expr="." position="inside">
            <link
                rel="stylesheet"
                href="/mis_builder_custom_reports/static/src/css/custom.css"
            />
        </xpath>
    </template>

    <record model="ir.ui.view" id="mis_report_view_kpi_form">
        <field
            name="name"
        >mis.report.view.kpi.form (in mis_builder_custom_reports)</field>
        <field name="model">mis.report.kpi</field>
        <field name="inherit_id" ref="mis_builder.mis_report_view_kpi_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='style_expression']" position="after">
                <field name="is_profit_loss" />
            </xpath>
        </field>
    </record>

</odoo>
